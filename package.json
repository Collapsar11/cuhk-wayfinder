{
  "name": "cuhk-campus-compass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "data:build": "node scripts/build-data.mjs && python3 scripts/build-geo.py && node scripts/build-shortcuts.mjs && node scripts/build-connections.mjs && python3 scripts/build-terrain-heights.py && node scripts/build-transit.mjs && node scripts/build-stop-places.mjs",
    "data:fetch": "python3 scripts/fetch_sources.py",
    "test:browser": "node scripts/browser-check.mjs",
    "deploy": "bash scripts/deploy-pages.sh",
    "test:site": "node scripts/verify-site.mjs",
    "android:release": "python3 scripts/build-android.py"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "maplibre-gl": "^6.11.2",
    "opencc-js": "^1.0.5",
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  }
}
